---
import ShellLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import { siteConfig } from '../site.config';
import '../styles/site.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = siteConfig.description, image = siteConfig.image } = Astro.props;
---

<ShellLayout {...siteConfig} title={title} description={description} image={image}>
  <slot />
</ShellLayout>
