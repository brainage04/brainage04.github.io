---
import ShellLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import { navigation } from '../data/navigation';
import '../styles/site.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Projects, writing, recipes, and browser tools by Australian developer brainage04.' } =
  Astro.props;
---

<ShellLayout
  title={title}
  siteName="brainage04"
  homeTitle="brainage04's website"
  navItems={navigation}
  sourceHref="https://github.com/brainage04/brainage04.github.io"
  description={description}
  image="/assets/images/graphic-design/profile-pictures/brainage04.jpg"
  faviconHref="/assets/images/graphic-design/profile-pictures/brainage04.jpg"
  faviconType="image/jpeg"
>
  <slot />
</ShellLayout>
