---
import { withBase } from '@brainage04/astro-shell/withBase';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../../../../layouts/BlogPostLayout.astro';
import { newestPostFirst, readingMinutes } from '../../../../../lib/blog';

interface PostLink {
  title: string;
  href: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  previous?: PostLink;
  next?: PostLink;
}

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(newestPostFirst);

  return posts.map((post, index) => {
    const match = post.data.slug.match(/^(?<year>\d{4})\/(?<month>\d{2})\/(?<day>\d{2})\/(?<slug>.+)\.html$/);
    if (!match?.groups) {
      throw new Error(`Invalid blog slug: ${post.data.slug}`);
    }

    const previousPost = posts[index + 1];
    const nextPost = posts[index - 1];

    return {
      params: match.groups,
      props: {
        post,
        previous: previousPost
          ? { title: previousPost.data.title, href: withBase(`/blog/${previousPost.data.slug}`) }
          : undefined,
        next: nextPost ? { title: nextPost.data.title, href: withBase(`/blog/${nextPost.data.slug}`) } : undefined,
      },
    };
  });
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout
  title={post.data.title}
  pubDate={post.data.pubDate}
  topic={post.data.topic}
  readingMinutes={readingMinutes(post.body)}
  headings={headings}
  previous={previous}
  next={next}
>
  <Content />
</BlogPostLayout>
