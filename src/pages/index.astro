---
import ProfileCard from '@brainage04/astro-shell/components/ProfileCard.astro';
import SiteLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import { withBase } from '@brainage04/astro-shell/withBase';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { getFeaturedProjects, groupProjects, projects } from '../data/projects';
import { socials } from '../data/socials';
import { pluralize } from '../lib/pluralize';

const projectGroups = groupProjects(projects);
const featuredProjects = getFeaturedProjects().slice(0, 3);
---

<SiteLayout>
  <div class="home-stack">
    <ProfileCard name="Thomas / brainage04" avatar="/pfp.webp" socials={socials}>
      <p class="lead">
        I make Minecraft mods/datapacks, Discord bots/plugins, websites, browser extensions and various other stuff.
        Based in Brisbane, Queensland, Australia.
      </p>
      <dl class="credentials">
        <div>
          <dt>Current role</dt>
          <dd>Graduate Associate Consultant working mostly with Microsoft Power Platform.</dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>Bachelor of Information Technology (Computer Science) with Distinction.</dd>
        </div>
      </dl>
    </ProfileCard>

    <section class="build-summary" aria-labelledby="build-summary-title">
      <div class="section-intro">
        <h2 id="build-summary-title">Projects</h2>
      </div>
      <div class="capability-list">
        {
          projectGroups.map((group) => (
            <article>
              <h3>{group.label}</h3>
              <span class="category-count">{pluralize(group.projects.length, 'project')}</span>
              <p>{group.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="featured-projects-heading">
      <div class="section-heading">
        <h2 id="featured-projects-heading">Featured projects</h2>
        <a href={withBase('/projects/')}>View the full catalogue</a>
      </div>
      <div class="showcase-grid">
        {featuredProjects.map((project) => <ProjectShowcase project={project} />)}
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .home-stack {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
  }

  .section-intro {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
  }

  .section-intro h2,
  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 1px;
    margin-block-start: 1.5rem;
    background: var(--border-subtle);
  }

  .capability-list article {
    padding: clamp(1rem, 2.5vw, 1.5rem);
    background: var(--surface);
    grid-column: span 2;
  }

  .capability-list article:nth-last-child(-n + 2) {
    grid-column: span 3;
  }

  .capability-list h3 {
    margin: 0;
    font-size: 1rem;
  }

  .category-count {
    display: block;
    margin-block-start: 0.35rem;
    color: var(--accent-primary);
    font: 700 0.75rem/1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .capability-list p {
    margin-block: 0.6rem 0;
    color: var(--foreground1);
    font-size: 0.88rem;
  }

  .section-heading {
    gap: 1rem;
    margin-block-end: 1.4rem;
    padding-block-end: 0.8rem;
  }

  .section-heading > a {
    font: 700 0.88rem/1.2 var(--font-mono);
    text-underline-offset: 0.2em;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.3rem);
  }

  .lead {
    max-width: 58ch;
    margin: 0;
    color: var(--foreground1);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
  }

  .credentials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
  }

  .credentials > div {
    padding-block-start: 0.65rem;
    border-block-start: 1px solid var(--border-subtle);
  }

  dt {
    color: var(--foreground2);
    font: 700 0.7rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.35rem 0 0;
    color: var(--foreground1);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .lead {
      margin-inline: auto;
    }

    .credentials {
      grid-template-columns: 1fr;
      text-align: start;
    }
  }

  @media (max-width: 900px) {
    .capability-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .capability-list article,
    .capability-list article:nth-last-child(-n + 2) {
      grid-column: span 1;
    }

    .capability-list article:last-child {
      grid-column: 1 / -1;
    }

    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .capability-list {
      grid-template-columns: 1fr;
    }

    .capability-list article:last-child {
      grid-column: auto;
    }
  }
</style>
