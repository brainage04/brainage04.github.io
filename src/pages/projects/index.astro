---
import ProjectCard from '../../components/ProjectCard.astro';
import { groupProjects, projects } from '../../data/projects';
import SiteLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import { pluralize } from '../../lib/pluralize';

const projectGroups = groupProjects(projects);
---

<SiteLayout title="Projects">
  <section aria-label="Projects">
    <div class="category-list">
      {
        projectGroups.map((group) => (
          <details class="project-group" id={group.id}>
            <summary>
              <span>{group.label}</span>
              <small>{pluralize(group.projects.length, 'project')}</small>
            </summary>
            <div class="subcategory-list">
              {group.subgroups.map((subgroup) => (
                <section class="project-subgroup" aria-labelledby={`${subgroup.id}-title`}>
                  <div class="subcategory-heading">
                    <h2 id={`${subgroup.id}-title`}>{subgroup.label}</h2>
                    <small>{pluralize(subgroup.projects.length, 'project')}</small>
                  </div>
                  <div class="catalogue-grid">
                    {subgroup.projects.map((project) => (
                      <ProjectCard project={project} />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .category-list {
    display: grid;
    gap: 0.75rem;
  }

  .project-group {
    min-width: 0;
    scroll-margin-block-start: 5rem;
    border-block-start: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .project-group summary {
    min-height: 3.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    cursor: pointer;
    color: var(--foreground0);
    font: 700 clamp(1rem, 2.4vw, 1.25rem)/1.2 var(--font-mono);
    text-align: start;
  }

  .project-group summary:hover,
  .project-group[open] summary {
    color: var(--accent-primary);
  }

  .project-group summary small {
    color: var(--foreground2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .subcategory-list {
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .subcategory-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.5rem;
  }

  .subcategory-heading h2,
  .subcategory-heading small {
    margin: 0;
  }

  .subcategory-heading h2 {
    font-size: 0.9rem;
  }

  .subcategory-heading small {
    color: var(--foreground2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--border-subtle);
  }

  .catalogue-grid > :global(.project-card:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }

  @media (max-width: 760px) {
    .catalogue-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .project-group summary {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
