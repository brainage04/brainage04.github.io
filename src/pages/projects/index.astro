---
import ProjectCard from '../../components/ProjectCard.astro';
import { groupProjects, projects } from '../../data/projects';
import SiteLayout from '../../layouts/SiteLayout.astro';

const projectGroups = groupProjects(projects);
const projectCountLabel = (count: number) => `${count} ${count === 1 ? 'project' : 'projects'}`;
---

<SiteLayout title="Projects">
  <section class="projects-page" aria-labelledby="projects-title">
    <h1 id="projects-title">Projects</h1>

    <div class="category-list">
      {projectGroups.map((group) => (
        <details class="project-group" id={group.id}>
          <summary>
            <span>{group.label}</span>
            <small>{projectCountLabel(group.projects.length)}</small>
          </summary>
          <div class="catalogue-grid">
            {group.projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </details>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .projects-page {
    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3rem, 10vw, 6.8rem);
    line-height: 0.86;
    letter-spacing: -0.075em;
  }

  .category-list {
    display: grid;
    gap: 0.75rem;
  }

  .project-group {
    min-width: 0;
    scroll-margin-block-start: 5rem;
    border-block-start: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .project-group summary {
    min-height: 3.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    cursor: pointer;
    color: var(--foreground0);
    font: 700 clamp(1rem, 2.4vw, 1.25rem)/1.2 var(--font-mono);
    text-align: start;
  }

  .project-group summary:hover,
  .project-group[open] summary {
    color: var(--accent-cyan);
  }

  .project-group summary small {
    color: var(--foreground2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--border-subtle);
  }

  @media (max-width: 760px) {
    .catalogue-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .project-group summary {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
