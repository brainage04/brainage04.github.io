---
/**
 * A compact single-select dropdown sized to the surrounding text: the options open as a row to the right of the
 * button (below it when the row would not fit). Behaviour lives in src/lib/popoutPicker.ts.
 *
 * The button is server-rendered with its final text and size, so nothing shifts when the script loads. Without
 * JavaScript it stays disabled and shows the current value.
 */
export interface Props {
  id: string;
  /** Accessible name. */
  label: string;
  options: readonly { value: string; label: string }[];
  selected: string;
}

const { id, label, options, selected } = Astro.props;
const summary = options.find((option) => option.value === selected)?.label ?? '';
---

<popout-picker id={id}>
  <button
    type="button"
    class="popout-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-options`}
    disabled
  >
    <span class="sr-only">{label}:</span>
    <span data-popout-summary>{summary}</span>
    <span class="popout-arrow" aria-hidden="true">›</span>
  </button>
  <div class="popout-panel" id={`${id}-options`} role="listbox" aria-label={label} aria-orientation="horizontal" hidden>
    {
      options.map((option) => (
        <div
          class="popout-option"
          role="option"
          data-value={option.value}
          aria-selected={option.value === selected ? 'true' : 'false'}
          tabindex={option.value === selected ? 0 : -1}
        >
          {option.label}
        </div>
      ))
    }
  </div>
</popout-picker>

<script>
  import '../lib/popoutPicker';
</script>

<style>
  /* Sized to the surrounding text: the button and the option row are one line of the parent's font tall. */
  popout-picker {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
  }

  .popout-panel[hidden] {
    display: none;
  }

  .popout-trigger {
    display: inline-flex;
    align-items: baseline;
    gap: 1ch;
    height: auto;
    margin: 0;
    padding: 0 0.05em;
    border: 0;
    border-block-end: 0.08em solid currentColor;
    background: none;
    color: var(--accent-primary);
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    cursor: pointer;
  }

  /*
   * Disabled only until the script has loaded (or for good without JavaScript); it keeps its look. WebTUI strikes
   * through disabled buttons and underlines focused ones; the trigger already has its own underline (the bottom
   * border), and a text decoration would also be drawn under the chevron and rotate with it.
   */
  .popout-trigger,
  .popout-trigger:focus,
  .popout-trigger:disabled {
    text-decoration: none;
  }

  .popout-trigger:disabled {
    opacity: 1;
    color: var(--accent-primary);
    cursor: default;
  }

  .popout-trigger:focus-visible,
  .popout-option:focus-visible {
    outline: 2px solid var(--accent-highlight);
    outline-offset: 1px;
  }

  .popout-arrow {
    transition: rotate 150ms ease;
  }

  .popout-trigger[aria-expanded='true'] .popout-arrow {
    rotate: 180deg;
  }

  .popout-panel {
    --popout-shift: 0px;
    position: absolute;
    z-index: 20;
    display: flex;
    gap: 0.2em;
    width: max-content;
    padding: 0;
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
    box-shadow: var(--shadow-raised);
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
  }

  /* The script sets --popout-baseline-shift so the options' baseline lands on the button text's baseline. */
  .popout-panel[data-placement='right'] {
    inset: var(--popout-baseline-shift, 0px) auto auto calc(100% + 0.3em);
  }

  .popout-panel[data-placement='below'] {
    inset: calc(100% + 0.2em) auto auto var(--popout-shift);
    flex-wrap: wrap;
    max-width: calc(100vw - 1rem);
  }

  /*
   * Every option is centred on the shared cap band: the box is trimmed to the cap height and the baseline, then padded
   * equally, keeping the row about one line tall beside the button.
   */
  .popout-option {
    padding: 0.24em 0.3em;
    background: var(--background1);
    color: var(--foreground1);
    white-space: nowrap;
    cursor: pointer;
    text-box: trim-both cap alphabetic;
  }

  .popout-option:hover {
    color: var(--accent-primary);
  }

  .popout-option[aria-selected='true'] {
    background: var(--accent-primary);
    color: var(--background0);
  }
</style>
