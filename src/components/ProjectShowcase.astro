---
import { Image } from 'astro:assets';
import { projectCategories, type Project } from '../data/projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const category = projectCategories[project.category];
---

<article class="project-showcase">
  <div class="project-visual" data-category={project.category} aria-hidden="true">
    {
      project.icon ? (
        <Image
          class:list={['project-icon', { pixelated: project.iconPixelated }]}
          src={project.icon}
          alt=""
          inferSize
          widths={project.iconPixelated ? undefined : [480, 768, 1024]}
          sizes="(max-width: 900px) 100vw, 33vw"
        />
      ) : (
        <span class="project-mark">{category.mark}</span>
      )
    }
  </div>
  <div class="project-content">
    <div class="meta-row project-meta">
      <span>{category.label}</span>
    </div>
    <h3>
      <a href={project.url}>
        {project.name}
      </a>
    </h3>
    {project.description && <p>{project.description}</p>}
    <ul class="chip-list" aria-label={`${project.name} language breakdown`}>
      {
        project.languages.map(({ name, percentage }) => (
          <li>
            {name} {percentage}%
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .project-showcase {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    box-shadow: var(--shadow-raised);
    transition:
      translate 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .project-showcase:hover,
  .project-showcase:focus-within {
    translate: 0 -0.2rem;
    border-color: color-mix(in srgb, var(--accent-primary) 70%, var(--foreground2));
    box-shadow: 0 1.4rem 3.2rem rgb(0 0 0 / 28%);
  }

  .project-visual {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-block-end: 1px solid var(--border-subtle);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--visual-accent) 13%, var(--background1)),
      var(--background0)
    );
    color: var(--visual-accent);
  }

  .project-visual[data-category='small-minecraft-mods'] {
    --visual-accent: #efb3c3;
  }

  .project-visual[data-category='large-minecraft-mods'] {
    --visual-accent: var(--accent-highlight);
  }

  .project-visual[data-category='templates-starters'] {
    --visual-accent: var(--accent-primary);
  }

  .project-visual[data-category='minecraft-dev-tools'],
  .project-visual[data-category='minecraft-datapacks'] {
    --visual-accent: #c9a2dc;
  }

  .project-visual[data-category='browser-extensions'],
  .project-visual[data-category='websites'],
  .project-visual[data-category='discord-bots'] {
    --visual-accent: #b78ac2;
  }

  .project-mark {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 1;
    translate: -50% -50%;
  }

  .project-mark {
    width: clamp(4.5rem, 9vw, 5.4rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    text-align: center;
    font: 700 clamp(3.3rem, 9vw, 5.4rem)/1 var(--font-mono);
  }

  .project-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-icon.pixelated {
    image-rendering: pixelated;
  }

  .project-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1rem, 2vw, 1.35rem);
  }

  .project-meta {
    gap: 0.45rem 0.75rem;
    line-height: 1.2;
  }

  h3 {
    margin-block: 0.9rem 0;
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    line-height: 1.1;
  }

  p {
    margin-block: 0.75rem 0;
    color: var(--foreground1);
    line-height: 1.55;
  }

  .chip-list {
    --chip-gap: 0.4rem;
    --chip-padding: 0.25rem 0.45rem;
    --chip-tint: 10%;
    --chip-color: var(--foreground1);
    --chip-font-size: 0.72rem;
    margin-block: 1rem 0;
  }
</style>
