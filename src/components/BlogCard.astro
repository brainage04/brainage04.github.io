---
import { withBase } from '@brainage04/astro-shell/withBase';
import type { CollectionEntry } from 'astro:content';
import { readingMinutes } from '../lib/blog';
import { formatBlogDate } from '../lib/formatDate';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const date = formatBlogDate(post.data.pubDate);
---

<article class="blog-card">
  <div class="meta-row post-meta">
    <span>{post.data.topic}</span>
    <span>{date}</span>
    <span>{readingMinutes(post.body)} min read</span>
  </div>
  <h2><a href={withBase(`/blog/${post.data.slug}`)}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
</article>

<style>
  .blog-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    border-block-start: 1px solid var(--border-subtle);
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent-primary) 4%, transparent), transparent 55%);
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .blog-card:hover,
  .blog-card:focus-within {
    border-block-start-color: var(--accent-primary);
    background-color: color-mix(in srgb, var(--accent-primary) 4%, transparent);
  }

  .post-meta {
    grid-column: 1 / -1;
    line-height: 1.3;
  }

  .post-meta span:first-child {
    color: var(--accent-primary);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.45rem, 3.5vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  p {
    grid-column: 1;
    margin: 0;
    color: var(--foreground1);
  }
</style>
