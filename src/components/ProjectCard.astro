---
import { Image } from 'astro:assets';
import { projectCategories, type Project } from '../data/projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const category = projectCategories[project.category];
---

<article class="project-card">
  <div class="project-icon" aria-hidden="true">
    {
      project.icon ? (
        <Image
          src={project.icon}
          class:list={{ pixelated: project.iconPixelated }}
          alt=""
          {...(project.iconPixelated ? { inferSize: true } : { width: 96, height: 96 })}
        />
      ) : (
        <span>{project.name.slice(0, 2).toUpperCase()}</span>
      )
    }
  </div>
  <div class="project-copy">
    <div class="meta-row project-meta">
      <span>{category.badge}</span>
    </div>
    <h3>
      <a href={project.url}>
        {project.name}
      </a>
    </h3>
    {project.description && <p>{project.description}</p>}
    <ul class="chip-list" aria-label={`${project.name} language breakdown`}>
      {
        project.languages.map(({ name, percentage }) => (
          <li>
            {name} {percentage}%
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1rem;
    border-block-start: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    transition:
      border-color 170ms ease,
      background-color 170ms ease,
      translate 170ms ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    translate: 0 -0.12rem;
    border-block-start-color: var(--accent-primary);
    background: var(--surface-raised);
  }

  .project-icon {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
    background: var(--background1);
    color: var(--accent-primary);
    font: 700 0.88rem/1 var(--font-mono);
  }

  .project-icon img,
  .project-icon span {
    width: 100%;
    height: 100%;
  }

  .project-icon img {
    display: block;
    object-fit: contain;
  }

  .project-icon img.pixelated {
    image-rendering: pixelated;
  }

  .project-icon span {
    display: grid;
    place-items: center;
    text-align: center;
  }

  .project-copy {
    min-width: 0;
  }

  .project-meta {
    gap: 0.35rem 0.7rem;
    font-size: 0.65rem;
    line-height: 1.2;
  }

  h3 {
    margin-block: 0.55rem 0;
    font-size: 1rem;
    line-height: 1.2;
  }

  p {
    margin-block: 0.55rem 0;
    color: var(--foreground1);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .chip-list {
    margin-block: 0.75rem 0;
  }

  @media (max-width: 420px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-icon {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
